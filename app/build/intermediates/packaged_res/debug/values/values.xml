<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#4A90E2</color>
    <color name="accent_gray">#4A4E6A</color>
    <color name="accent_green">#27AE60</color>
    <color name="accent_purple">#8E44AD</color>
    <color name="accent_yellow">#F39C12</color>
    <color name="bg_card">#252840</color>
    <color name="bg_dark">#1A1D2E</color>
    <color name="btn_blue">#2D6CB5</color>
    <color name="btn_gray">#3A3D55</color>
    <color name="btn_green">#1E8449</color>
    <color name="btn_purple">#6C3483</color>
    <color name="divider">#3A3D55</color>
    <color name="status_error">#5C1A1A</color>
    <color name="status_idle">#252840</color>
    <color name="status_navigating">#1A3A5C</color>
    <color name="text_hint">#6B6F8A</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0B3CC</color>
    <string name="app_name">Robot Navigation</string>
    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:backgroundTint">@color/divider</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
    </style>
    <style name="NavButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:lines">3</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>
    <style name="NavButton.Blue" parent="NavButton">
        <item name="backgroundTint">@color/btn_blue</item>
    </style>
    <style name="NavButton.Gray" parent="NavButton">
        <item name="backgroundTint">@color/btn_gray</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="NavButton.Green" parent="NavButton">
        <item name="backgroundTint">@color/btn_green</item>
    </style>
    <style name="NavButton.Purple" parent="NavButton">
        <item name="backgroundTint">@color/btn_purple</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Theme.NavLearner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
    </style>
</resources>